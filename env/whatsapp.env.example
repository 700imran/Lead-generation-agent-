# ===== WhatsApp lane profile (one WhatsApp Cloud API number per profile) =====
OPENROUTER_API_KEY=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
# Webhook port is set automatically per profile by setup_profiles.sh (8090, 8091, ...).
# Expose it to Meta with a tunnel / reverse proxy: https://<host>/whatsapp/webhook
WHATSAPP_CLOUD_ALLOWED_USERS=
# First-contact messages need Meta-approved templates (WhatsApp policy); free text only
# works inside the 24h window after the prospect messages you.
