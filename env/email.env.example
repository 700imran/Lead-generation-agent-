# ===== email lane profile (one mailbox per profile) =====
OPENROUTER_API_KEY=
EMAIL_ADDRESS=
EMAIL_PASSWORD=          # app password
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_POLL_INTERVAL=60
# Prospect replies must be able to reach the agent. Prefer an explicit allowlist you extend
# from the CRM; EMAIL_ALLOW_ALL_USERS=true lets ANY sender trigger the agent (spam risk).
EMAIL_ALLOWED_USERS=
# EMAIL_ALLOW_ALL_USERS=false
